COMPOSE_PROJECT_NAME="tls-cert-manager"


# Specify a name for the docker image. This should not include any registry name.
DOCKER_IMAGE_NAME="tls-cert-manager"


# Specify the environment. Either "dev" or "production"
ENVIRONMENT="production"


# Specify if you wish for this service to manage TLS/SSL. You should only set this to 0
# if you are running behind a proxy that does this for you, as this service relies on
# using encrypted connections for security.
SSL_ENABLED=0


# Specify the ID and group ID of your user. You only need to specify these if you
# are developing this codebase.
#HOST_USER_ID=1000
#HOST_GROUP_ID=1000


# Provide an ID for the first admin auth token.
# This should be a UUIDv4, which you can create at: 
# https://www.uuidgenerator.net/
ADMIN_AUTH_TOKEN_ID=""

# provide the base64 encoded hash of the admin token/secret. You can generate this by running
# "php -a" in a terminal, and then entering:
# echo base64_encode(password_hash("mySuperSecurePasswordGoesHere", PASSWORD_DEFAULT));
ADMIN_AUTH_TOKEN_HASH=""


# Specify the database credentials.
DB_NAME=
DB_USER=
DB_PASSWORD=
